# =============================================
# 로컬 개발 환경변수 샘플
# 복사 후 .env 로 이름 변경: cp .env.sample .env
# =============================================

# Spring Boot 필수 (JWT)
JWT_SECRET=local-dev-secret-key-please-change-in-production

# Docker Hub 이미지 푸시용 (선택)
DOCKER_USERNAME=local

# DB (application.yml 기본값과 동일 — 변경 시에만 설정)
DB_USERNAME=user
DB_PASSWORD=password
DB_URL=jdbc:postgresql://localhost:5432/carpool

# Google OAuth2 (소셜 로그인 사용 시 팀 단톡방 자격증명 입력)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
