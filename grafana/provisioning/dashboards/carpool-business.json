{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "HTTP 성능",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"carpool\"}[1m])) by (le, uri))",
          "legendFormat": "p95 {{uri}}",
          "refId": "A"
        }
      ],
      "title": "HTTP 응답시간 p95 (URI별)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"carpool\", status=~\"5..\"}[1m]))",
          "legendFormat": "5xx 에러율",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"carpool\", status=~\"4..\"}[1m]))",
          "legendFormat": "4xx 에러율",
          "refId": "B"
        }
      ],
      "title": "HTTP 에러율 (4xx / 5xx)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "비즈니스 메트릭",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "targets": [
        {
          "expr": "rate(carpool_applications_submitted_total[1m])",
          "legendFormat": "신청 제출",
          "refId": "A"
        },
        {
          "expr": "rate(carpool_applications_accepted_total[1m])",
          "legendFormat": "신청 수락",
          "refId": "B"
        },
        {
          "expr": "rate(carpool_applications_rejected_total[1m])",
          "legendFormat": "신청 거절",
          "refId": "C"
        }
      ],
      "title": "카풀 신청 흐름 (rate/min)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "targets": [
        {
          "expr": "rate(carpool_posts_created_total[1m])",
          "legendFormat": "게시글 생성",
          "refId": "A"
        },
        {
          "expr": "rate(carpool_posts_closed_total[1m])",
          "legendFormat": "게시글 마감",
          "refId": "B"
        },
        {
          "expr": "rate(carpool_rides_started_total[1m])",
          "legendFormat": "라이드 시작",
          "refId": "C"
        },
        {
          "expr": "rate(carpool_rides_completed_total[1m])",
          "legendFormat": "라이드 완료",
          "refId": "D"
        }
      ],
      "title": "게시글 & 라이드 생명주기",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 18 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "rate(carpool_optimistic_lock_conflicts_total[1m]) * 60",
          "legendFormat": "충돌/분",
          "refId": "A"
        }
      ],
      "title": "Optimistic Lock 충돌 (동시 신청 경쟁)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 18 },
      "id": 6,
      "targets": [
        {
          "expr": "rate(carpool_location_updates_total[1m])",
          "legendFormat": "위치 업데이트/초",
          "refId": "A"
        }
      ],
      "title": "드라이버 위치 업데이트 빈도",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "인프라 메트릭",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "max": 10 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "active" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 7,
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"carpool\"}",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"carpool\"}",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_max{application=\"carpool\"}",
          "legendFormat": "max",
          "refId": "C"
        }
      ],
      "title": "DB 커넥션 풀 (HikariCP)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 8,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(lettuce_command_completion_seconds_bucket{application=\"carpool\"}[1m])) by (le))",
          "legendFormat": "Redis p95",
          "refId": "A"
        }
      ],
      "title": "Redis 응답시간 p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "pending(대기 스레드)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "max(=30)" },
            "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "id": 9,
      "targets": [
        {
          "expr": "hikaricp_connections_pending{application=\"carpool\"}",
          "legendFormat": "pending(대기 스레드)",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_active{application=\"carpool\"}",
          "legendFormat": "active",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_max{application=\"carpool\"}",
          "legendFormat": "max(=30)",
          "refId": "C"
        }
      ],
      "title": "HikariCP 대기 스레드 (pending) — 커넥션 풀 포화 지표",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "획득 타임아웃/초" },
            "properties": [
              { "id": "unit", "value": "ops" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "id": 10,
      "targets": [
        {
          "expr": "rate(hikaricp_connections_acquire_seconds_sum{application=\"carpool\"}[1m]) / clamp_min(rate(hikaricp_connections_acquire_seconds_count{application=\"carpool\"}[1m]), 0.001)",
          "legendFormat": "커넥션 획득 평균 대기",
          "refId": "A"
        },
        {
          "expr": "rate(hikaricp_connections_timeout_total{application=\"carpool\"}[1m])",
          "legendFormat": "획득 타임아웃/초",
          "refId": "B"
        }
      ],
      "title": "HikariCP 커넥션 획득 대기 & 타임아웃",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["carpool", "business"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Carpool Business Metrics",
  "uid": "carpool-business-001",
  "version": 1
}
